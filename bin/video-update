#!/usr/bin/env bash

# Resolve project root dynamically
PRG="$0"
while [ -h "$PRG" ]; do
    ls=`ls -ld "$PRG"`
    link=`expr "$ls" : '.*-> \(.*\)$'`
    if expr "$link" : '/.*' > /dev/null; then
        PRG="$link"
    else
        PRG=`dirname "$PRG"`/"$link"
    fi
done
BIN_DIR=`dirname "$PRG"`
PROJECT=`cd "$BIN_DIR/.." && pwd`

echo
echo "========================================"
echo "       VIDEO EXTRACTOR UPDATE"
echo "========================================"
echo

if command -v pkg >/dev/null 2>&1; then
    echo "[+] Updating Termux packages..."
    pkg update -y
fi

echo
echo "[+] Updating Python dependencies..."

PYTHON_BIN="python3"
if ! command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="python"
fi

"$PYTHON_BIN" -m pip install --upgrade \
    requests \
    beautifulsoup4 \
    yt-dlp \
    selenium \
    "scrapling[fetchers]" \
    langgraph \
    psutil \
    markdownify

echo
echo "[+] Updating Scrapling browser dependencies..."
if command -v scrapling >/dev/null 2>&1; then
    scrapling install
fi

echo
echo "[+] Checking FFmpeg..."

if command -v ffmpeg >/dev/null 2>&1; then
    echo "[✓] FFmpeg OK"
else
    echo "[!] FFmpeg missing"
    if command -v pkg >/dev/null 2>&1; then
        echo "[+] Installing FFmpeg via pkg..."
        pkg install ffmpeg -y
    fi
fi

echo
echo "[+] Checking Chromium..."

if command -v chromium >/dev/null 2>&1 || command -v chromium-browser >/dev/null 2>&1; then
    echo "[✓] Chromium OK"
else
    echo "[!] Chromium missing"
    if command -v pkg >/dev/null 2>&1; then
        echo "[+] Installing Chromium via pkg..."
        pkg install x11-repo -y
        pkg install chromium -y
    fi
fi

echo
echo "========================================"
echo "             UPDATE COMPLETE"
echo "========================================"
echo
