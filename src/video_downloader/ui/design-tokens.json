{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Mission Control Tactical Dark",
  "version": "1.0.0",
  "axioms": {
    "geometry": {
      "borderRadius": "0px",
      "enforceZeroRadius": true
    },
    "dialect": "mission-control-design",
    "disallowed_properties": [
      "border-radius",
      "box-shadow: 0px 10px 30px",
      "backdrop-filter: blur"
    ],
    "motion_rules": {
      "maxDurationMs": 300,
      "disallowEaseIn": true,
      "requireReducedMotion": true
    }
  },
  "color": {
    "bg": { "$value": "#0A0D10", "$type": "color" },
    "panel": { "$value": "#11161A", "$type": "color" },
    "panel2": { "$value": "#151B20", "$type": "color" },
    "line": { "$value": "#232C31", "$type": "color" },
    "ink": { "$value": "#E6ECE8", "$type": "color" },
    "muted": { "$value": "#6C7E78", "$type": "color" },
    "accentStatus": { "$value": "#39FF88", "$type": "color" },
    "accentStatusDim": { "$value": "#1C7A45", "$type": "color" },
    "accentAction": { "$value": "#FFB627", "$type": "color" },
    "accentActionDim": { "$value": "#8C640F", "$type": "color" },
    "accentDestructive": { "$value": "#FF5C4D", "$type": "color" },
    "grid": { "$value": "rgba(57, 255, 136, 0.05)", "$type": "color" }
  },
  "solarLight": {
    "bg": { "$value": "#EDEDE9", "$type": "color" },
    "panel": { "$value": "#F5EBE0", "$type": "color" },
    "panel2": { "$value": "#E3D5CA", "$type": "color" },
    "line": { "$value": "#C4B8AD", "$type": "color" },
    "ink": { "$value": "#24201D", "$type": "color" },
    "muted": { "$value": "#756B62", "$type": "color" },
    "accentStatus": { "$value": "#2B824E", "$type": "color" },
    "accentStatusDim": { "$value": "#4B9B69", "$type": "color" },
    "accentAction": { "$value": "#B8731D", "$type": "color" },
    "accentActionDim": { "$value": "#8A520B", "$type": "color" },
    "accentDestructive": { "$value": "#C43D2F", "$type": "color" },
    "grid": { "$value": "rgba(160, 145, 130, 0.16)", "$type": "color" }
  },
  "typography": {
    "fontDisplay": { "$value": "'Big Shoulders Display', sans-serif", "$type": "fontFamily" },
    "fontMono": { "$value": "'JetBrains Mono', monospace", "$type": "fontFamily" }
  },
  "motion": {
    "durationQuick": { "$value": "120ms", "$type": "duration" },
    "durationStandard": { "$value": "200ms", "$type": "duration" },
    "durationSmooth": { "$value": "300ms", "$type": "duration" },
    "easeSnap": { "$value": [0.23, 1, 0.32, 1], "$type": "cubicBezier" },
    "easeMechanicalBounce": { "$value": [0.3, 1.5, 0.5, 1], "$type": "cubicBezier" }
  }
}
